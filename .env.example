BOT_TOKEN=discord_bot_token
CLIENT_ID=discord_application_id
NYX_AUTH_URL=https://nyx-access-website.onrender.com
BOT_API_SECRET=same_value_as_render
AUDIT_LOG_CHANNEL_ID=optional_private_admin_log_channel
# Comma-separated Discord guild IDs the bot is allowed to operate in.
# Commands are refused everywhere else (fail-closed). Add more at runtime
# with /owner allow.
ALLOWED_GUILD_IDS=your_server_id_here
# Comma-separated Discord user IDs that own the bot and can use /owner.
BOT_OWNER_IDS=your_discord_user_id_here
# Giveaway tuning (all optional)
GIVEAWAY_MAX_KEYS=10
GIVEAWAY_COOLDOWN_MINUTES=0
GIVEAWAY_CHANNEL_ID=
GIVEAWAY_AUTO_INTERVAL_HOURS=0
GIVEAWAY_AUTO_DURATION=1w
GIVEAWAY_AUTO_COUNT=3
# Support tickets: category that ticket channels are created under, and an
# optional channel to archive closed-ticket transcripts to (falls back to
# AUDIT_LOG_CHANNEL_ID when unset).
TICKET_CATEGORY_ID=
TICKET_TRANSCRIPT_CHANNEL_ID=
# Verification: role granted to members whose Discord is linked to an active
# license (via /verify, automatically on join, and cleaned up by /verifysync).
VERIFY_ROLE_ID=
# Scheduled daily digest. Set DIGEST_CHANNEL_ID plus either DIGEST_TIME
# (HH:MM, 24-hour UTC — wins over the interval) or DIGEST_INTERVAL_HOURS.
DIGEST_CHANNEL_ID=
DIGEST_TIME=
DIGEST_INTERVAL_HOURS=0
# Giveaway claim gating (all optional): require a role, require a linked NYX
# account, and/or a per-user cooldown in minutes between claims.
GIVEAWAY_REQUIRED_ROLE_ID=
GIVEAWAY_REQUIRE_LINKED=false
GIVEAWAY_CLAIM_COOLDOWN_MINUTES=0
# Per-user rate limit for public API commands (/mystatus, /redeem, /verify).
PUBLIC_RATE_LIMIT_PER_MINUTE=10
# NOTE: BOT_API_SECRET_PREVIOUS is used by the website (Render) during
# secret rotation and is NOT read by the bot itself.
