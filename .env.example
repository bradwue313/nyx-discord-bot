BOT_TOKEN=discord_bot_token
CLIENT_ID=discord_application_id
NYX_AUTH_URL=https://nyx-access-website.onrender.com
BOT_API_SECRET=same_value_as_render
AUDIT_LOG_CHANNEL_ID=optional_private_admin_log_channel
# Comma-separated Discord guild IDs the bot is allowed to operate in.
# Commands are refused everywhere else (fail-closed). Add more at runtime
# with /owner allow.
ALLOWED_GUILD_IDS=your_server_id_here
# Comma-separated Discord user IDs that own the bot and can use /owner.
BOT_OWNER_IDS=your_discord_user_id_here
